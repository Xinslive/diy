# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Node
# 根目录的 node_modules/ 是 tools/uitest/ 那批 Playwright 探测脚本的依赖
# （清单在根 package.json）；前端应用自己的依赖在 frontend/，node_modules 不入库。
node_modules/
dist/
.vite/
*.local

# 环境与密钥
.env
.env.*
!.env.example

# 调试产物
.shots/
dbg*.mjs
dl.mjs
*.log

# 编辑器
.DS_Store
.idea/
.vscode/

# 本地开发环境（dev.sh 生成的 pid/日志）
.run/

# 运行时数据。发票原件与解析结果（data/invoices）含购销方税号等敏感信息，只留本机。
data/
