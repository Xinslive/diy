[Unit]
Description=云财务记账系统 数据库定时备份
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=cwq
Group=cwq
WorkingDirectory=/opt/cwq/backend

# ---------------------------------------------------------------------------
# TimeoutStartSec：**必须显式给**，不能靠 systemd 的默认值。
# ---------------------------------------------------------------------------
#
# `Type=oneshot` 的服务，**整个执行时长**都算在 TimeoutStartSec 里面 ——
# 不是「启动到 ready 的那一段」。而 systemd 的 DefaultTimeoutStartSec
# 默认只有 90 秒。
#
# 后果不是「备份慢了一点」，而是**一个备份产物都没有**：
# 库长到 pg_dump 要跑超过 90 秒（1.6 GB / 2 核的机器上很常见）→ systemd
# 到点 SIGTERM → db_backup.py 的 dump_to_file 走异常路径把临时文件 unlink 掉
# → **目录里一个备份都不剩**，unit 状态 failed。
#
# 而「没有备份」这件事**不报错**：timer 显示 enabled、每天到点跑、
# 每天都失败、没人看 journal —— 比没有定时备份更危险，因为它看起来是有的。
#
# 1800 秒（30 分钟）是对着「库长到几 GB 时一次 pg_dump 要几分钟」给的余量。
# 对照：同一个仓库里的 cwq-deploy.service 用的是 1800。
TimeoutStartSec=1800

EnvironmentFile=/opt/cwq/backend/.env

# 保留最近 N 份。**不要去掉 --keep**：没有保留策略的每日备份会慢慢把
# 磁盘写满，而磁盘写满之后下一个失败的就是备份本身 ——
# 一个把自己搞挂的备份策略。14 份 ≈ 两周回溯窗口。
Environment=CWQ_BACKUP_KEEP=14

# 落盘目录与文件名里的日期要拿到 YYYY-MM-DD 这个**日期**。
#
# **这里原来写的是 %F —— 那是个不存在的 systemd 规格符。**
# %F 是 strftime 的写法（和 date +%F 一样），不是 systemd 的。systemd 解析不到
# 对应字段就报 `Failed to resolve unit specifiers ...: Invalid slot`，
# **整个 unit 被判为不可加载** —— timer 启动时只说
# 「cwq-backup.service to trigger not loaded」，一条真正的报错藏在
# `systemd-analyze verify` 里。表现是「脚本说启用失败、照它给的命令再敲一遍
# 还是失败」，而这正是没有定时备份的最坏形态：看起来有。
#
# **也不要以为换成 %Y-%m-%d 就对了 —— 那更坏。**
# systemd 的 `%m` 是 **machine ID**、`%d` 是 **state 目录**、`%S` 是 cache 目录、
# `%H` 是主机名：这一组规格符里**没有任何一个是日期分量**。本机实测
# （Debian 12 / systemd 252.39）把 `%Y-%m-%d` 写进去的结果是：
# unit 能加载、`systemctl start` 返回 **Result: success**，
# 而 `--out` 拿到的是一个被拼成目录的路径，备份脚本的
# ``out.parent.mkdir(parents=True)`` 造出 `db-/etc/systemd/` 这棵树，
# **一个字节的备份都没产生**。
# 也就是说：照这条改完之后，备份会以「每天都成功」的姿态静默地什么都不做，
# 还要把 ``--keep`` 的清理范围算在那个空目录上。这比 unit 加载失败危险得多 ——
# 后者至少会吵。
#
# 结论：**systemd 没有日期规格符，这活儿必须借 shell。**
# ExecStart 不走 shell，所以要显式写成 `/bin/sh -c`，并且：
#   * `$$` —— systemd 的转义，交给 shell 一个字面 `$`（否则 `$` 会被 systemd 吃掉）
#   * `%%F` —— systemd 把 `%%` 还原成 `%`，shell 才看得到 `date +%F`
#   * `${CWQ_BACKUP_KEEP}` —— 仍然是 systemd 展开（Environment 里给了默认值 14），
#     不经 shell，免得依赖 shell 的变量语义
#
# 文件名用固定日期而不是内容哈希：出事了运维要一眼看出「这是哪天的」。
# 同一天重复跑会覆盖同一个文件，这没问题 —— 同一天的两份备份没有区别。
ExecStart=/bin/sh -c 'exec /opt/cwq/backend/.venv/bin/python scripts/db_backup.py \
    --out /opt/cwq/backups/db-$$(date +%%F).sql \
    --keep ${CWQ_BACKUP_KEEP}'

# ---------------------------------------------------------------------------
# 加固项：**不能照抄 cwq-api.service**。
#
# 那个 unit 用 `ProtectSystem=strict` + `ReadWritePaths=/opt/cwq/backend/logs`，
# 意思是「除了这一个白名单目录，整个文件系统只读」。
# 这里要写 /opt/cwq/backups —— 一个**不同的**目录。照抄的话备份会写不进去，
# 而 systemd 只会报一个含糊的失败码，不会在日志里说「因为没在 ReadWritePaths 里」。
# 于是表现是「定时任务每天都跑、每天都失败、没人看 journal」——
# 比没有定时备份更危险，因为它看起来是有的。
# ---------------------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cwq/backups

StandardOutput=append:/opt/cwq/backups/backup.log
StandardError=append:/opt/cwq/backups/backup.log
