[Unit]
Description=云财务记账系统 API (FastAPI)
After=network.target postgresql.service
Wants=postgresql.service
# ---------------------------------------------------------------------------
# 重启风暴闸（2026-10-24 性能审计补上）
# ---------------------------------------------------------------------------
# **默认的 5 次 / 10 秒对一台 1.6 GB 的机器是灾难性的。**
#
# 记忆吃满 → 进程被杀 → systemd 拉起来 → 进程又吃满 → 再被杀 ——
# 每 3 秒一轮，每一轮都要：fork 两个 worker、重新导入框架、重新建连接池、
# 跑一次 schema 预检。CPU 与磁盘 I/O 全耗在这上面，**而真正的服务一次都没起来**。
#
# 收紧成「5 分钟内最多 5 次」之后：偶发的一次崩溃仍然会自动恢复（5 次以内），
# 但**持续性的资源不足会显形** —— 单元进入 failed 状态，journal 里能看到，
# 而不是被一轮又一轮的重启淹没成「服务时好时坏」。
#
# 这两个键必须写在 **[Unit]** 段里（systemd 的 StartLimit* 是 Unit 段的键，
# 写在 [Service] 段会被忽略且不报错）。
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=cwq
Group=cwq
WorkingDirectory=/opt/cwq/backend
# worker 进程数。**默认值 = 2**，与这里原来写死的 `--workers 2` 完全一致 ——
# 这次只是让它可配，容量要不要动是另一件事（要拿 CPU 核数与并发数据说话）。
#
# 为什么写成变量而不是把它留在 ExecStart 里：同一个数在 deploy/systemd 和
# backend/Dockerfile 里各写死一份，改一处忘一处就会出现「systemd 4 个、
# Docker 2 个」，而两边连的是同一个 uvicorn 进程模型。
#
# **ExecStart 不走 shell**，所以 `${VAR:-2}` 那种「带兜底值」的写法不存在 ——
# systemd 只认自己的变量展开，而**未定义的变量会展开成空字符串**（不是保留
# 原样）。所以这里用 Environment= 给死默认值，再用 EnvironmentFile 让运维覆盖：
#   * Environment= 必须写在 EnvironmentFile= **之前**。systemd >= 250 是
#     「后写的覆盖先写的」，< 250 是「文件无条件覆盖 Environment=」——
#     放在前面，两种版本下结论一致：都是 .env 说了算。
#   * .env 里没有这一项时，用的仍然是这里的 2，不会展开成空。
# 名字带 CWQ_ 前缀是为了和 .env 里其它应用侧配置区分开：这个变量是
# **给 systemd 读的**，config.py 里没有、也不应该有对应字段（Python 那边
# 读不到它，留一个读不到的配置项比没有更危险）。
Environment=CWQ_API_WORKERS=2
EnvironmentFile=/opt/cwq/backend/.env
Environment=TZ=Asia/Shanghai
# 只做一件事：把「.env 里把这一项清空了」这种手滑，从「uvicorn 收到空的
# --workers 参数、Restart=always 无限重启刷日志」变成一条看得懂的启动失败。
ExecStartPre=/bin/sh -c 'case "$CWQ_API_WORKERS" in ""|*[!0-9]*|0) echo "CWQ_API_WORKERS 必须是正整数（.env 里不能把它清空）" >&2; exit 1;; esac'
# schema/数据库预检，与开发环境 dev.sh 调的是**同一个入口**。
#
# 为什么生产也要有这一道（2026-10-17）：开发环境用 --reload，schema 闸门在
# uvicorn 的 startup 里拦人，拦下来的形态是「reloader 父进程还握着 :8000 的
# LISTEN 套接字、worker 已退出、于是没人 accept」—— 连接能建、请求永不
# 应答、SIGTERM 还杀不掉它（父进程阻塞在 os_waitpid，收不到那个让它退出的
# Event）。那个形态在日志里只有一行 SchemaVersionError，而在外面看就是
# 「服务挂了但端口还在」。
#
# 生产这里虽然**没有 --reload**（走 --workers），但闸门放在 startup 里仍有一个
# 真实的代价：失败时 systemd 看到的是「进程反复退出」，配 Restart=always
# 就是每 3 秒刷一轮，而真实原因埋在日志中段。放在 ExecStartPre 里，失败会
# 变成一条明确的启动失败，日志里紧挨着原因与该执行的命令。
#
# 退出码是有含义的，systemd 的日志能直接分辨处置方向：
#   3 = schema 版本对不上 → 跑 alembic upgrade head（或 stamp，见报错文案）
#   4 = 数据库连不上     → 查 postgresql.service / 网络 / 连接串
# 它**不执行任何 DDL**：建表改表只由 Alembic 负责，启动路径只做版本检查。
ExecStartPre=/opt/cwq/backend/.venv/bin/python scripts/preflight.py
ExecStart=/opt/cwq/backend/.venv/bin/python scripts/start_server.py \
    --server uvicorn --host 127.0.0.1 --port 8000
# **Restart=on-failure，不是 always**（2026-10-24 性能审计改）。
#
# `always` 的语义是「**不管怎么退出都重启**」—— 包括**干净退出**。
# 内存吃满被 OOM killer 杀掉时当然要重启，但 `always` + `RestartSec=3`
# 意味着「一杀一拉」每 3 秒一轮，每一轮都要重新 fork 两个 worker、重新导入
# 框架、重新建连接池。**服务一次都没真正起来**，CPU 与 I/O 却全耗在重启上 ——
# 这正是「生产服务器性能不够高」最容易被误判成「数据库慢」的那种形态。
#
# `on-failure` 只在**非零退出码或被信号杀死**时重启：崩溃/OOM 仍然自动恢复，
# 而正常停机（发版、运维 stop）不再被 systemd 拉起来。
Restart=on-failure
# 3 秒 → 10 秒：配合上面的 StartLimitBurst=5，给「短暂内存尖峰」留出
# 自行退让的时间（Linux 会在压力下回收页缓存，而不是立刻杀进程），
# 同时把持续失败时的重启风暴压到 5 分钟 5 次。
RestartSec=10
# **OOMPolicy=kill**：cgroup 被 OOM killer 命中时，把**整个单元**一起收掉，
# 由 systemd 干净地重启。
#
# 默认的 `stop` 只杀掉主进程（uvicorn 父进程），两个 worker 可能活下来变成
# 孤儿 —— 于是端口还占着、请求没人应答，而 systemd 认为服务已经停了。
# 这与本文件 ExecStartPre 那段注释里描述的「服务挂了但端口还在」是同一类
# 故障，只是触发原因不同。
OOMPolicy=kill
# **CPUWeight=50**：这台机同时跑着另外 11 个子域与 3 个 Docker 容器，
# API 不是唯一的乘客。CPUWeight 只在**竞争**时按权重分配，机器空闲时
# 仍然把 CPU 全给它 —— 所以它不影响本服务的独占性能，只在抢的时候让路。
#
# 刻意**不**用 CPUQuota：限流是把「这台机器一共多少 CPU」当成 API 的独享
# 额度，而实际配额要按 `nproc` 与其它负载实测定，猜一个数写死在模板里
# 只会变成新的「随手写的数字」。要限就用 systemd 的
# `CPUQuota=` 在**生产机上手工**加，且必须先量出并发与延迟的取舍。
CPUWeight=50
# **TasksMax=512**：线程/进程数上限。
#
# 算式：2 个 worker × anyio 默认线程池 40 = 80，再加调度器一次 tick 的
# 最多 20 路 fan-out（`asyncio.gather(run_in_threadpool(...))`）= 100，
# 加两个 worker 本身与余量。512 给的是余量，不是紧箍咒。
TasksMax=512

# ---------------------------------------------------------------------------
# 文件描述符上限（2026-10-15 压测基线后补）
# ---------------------------------------------------------------------------
# 这个数**不是随手写的**，它要同时盖住三样东西，取它们的最大值再加余量：
#   * nginx upstream keepalive 32（cwq.conf 里每个 worker 进程持有）
#   * 数据库连接 2 ×(pool_size 5 + max_overflow 10) = 30
#   * 每个入站 HTTP 连接本身也要占一个 fd
# systemd 的默认值是 1024，而 **LimitNOFILE 是硬上限，不是软限**：
# 超了进程报 EMFILE，日志里表现为
# ``OSError: [Errno 24] Too many open files`` 或 uvicorn 直接退出重启，
# 很容易被误判成「服务不稳定」而查不到根因。
#
# **这里原来还有一行 LimitNOFILESoft=8192，它在 systemd 上是「未知键、
# 静默忽略」** —— systemd-analyze verify 会报
# ``Unknown key 'LimitNOFILESoft' in section [Service], ignoring.``，
# 而 `systemctl show` 一切正常，于是没人会发现。
#
# 不需要它：**LimitNOFILE= 在 systemd < 254 上同时设置软限与硬限**。
# 本机（Debian 12 / systemd 252.39）实测，cwq-api 进程的
# ``/proc/<pid>/limits`` 是 ``Max open files 8192 8192`` —— 两档都是 8192。
# 原文注释里「要调软限得在 Limits 里一起给 LimitNOFILE= 与 LimitNOFILESoft=」
# 这条说法对 systemd 252 是错的，删掉这个键没有损失任何东西。
LimitNOFILE=8192

# 内存软上限：让 cgroup 的内存压力先在 API 上表现出来（内核回收、
# 分配失败），而不是整机耗尽后由 OOM killer 在**几个进程里随机挑一个**杀。
# 挑到 postgresql 后果更糟：数据库被杀会让未提交事务回滚、连接被断开，
# 而挑到 API 只是 503。设一个明显高于实测（API 稳态约 220 MB）的上限，
# 目的不是限流，而是让「要出事时先出谁」这件事是确定的。
#
# 注意：OOM 优先杀的是 cgroup 内 **占用最多的**进程，所以这个值必须留够
# 余量，否则它挡不住 OOM killer 去动 PG —— 真要保护 PG，正确的做法是
# 给 postgres 单独的 systemd 单元加 MemoryMax，而不是给 API 加。
# 见 deploy/tuning.md。
#
# ---- 2026-10-24 性能审计：这一行原来是**注释掉的** ----
#
# 注释掉 = API 的 cgroup **没有任何内存上限**，于是整台机器的内存压力
# 全部由整机 OOM killer 决定杀谁 —— 而 OOM killer 挑的是**占用最多的**那个
# 进程，也就是 PostgreSQL。PG 被杀 = 未提交事务回滚、连接被断开，
# 症状是「偶发的 500 / 连接重置」，而根因在应用这边，根本查不到。
#
# 现在给两档：
#   * **MemoryHigh=400M** —— 软上限。超过之后内核开始回收本 cgroup 的
#     页缓存并对进程施加节流（分配变慢），**不杀进程**，正是「先让它慢下来，
#     而不是先让它死」。
#   * **MemoryMax=512M** —— 硬上限。超过就由 cgroup 的 OOM killer 杀
#     **本 cgroup 内**的进程（配合上面的 OOMPolicy=kill，整个单元一起走，
#     systemd 干净重启）。
#
# 这两个数是按 **1.6 GB 生产机**（acct.xins.live）定的 —— 那台机还同时
# 跑着 11 个子域与 3 个 Docker 容器。给 API 划一条明确的边界，比让
# 「谁被 OOM killer 挑中」变成随机事件要好得多。
#
# ---- 2026-10-24 生产机实测（acct.xins.live / 8.155.171.57）----
#
# **先说结论：这一段是「预防」，不是「修已经发生的故障」。**
# ``/proc/vmstat`` 的 ``oom_kill = 0`` —— 这台机器**从来没有被 OOM killer
# 杀过任何进程**（dmesg 里查不到 OOM 记录是正常的，不是日志被清掉了）。
# 所以下面这两档在今天的作用是：**让「出事时先动谁」变成一件确定的事**，
# 而不是等整机内存耗尽时由内核随机挑一个占用最大的进程杀掉 ——
# 那样被杀的多半是 PostgreSQL，症状是「偶发 500 / 连接重置」，根因却
# 在应用这边，根本查不到。
#
# 机器实测：``nproc=2``、``Mem total 1676 MB``、**有 1 GB swap**
# （``/www/swap``，已用 193 MB）、``oom_kill=0``、``pgmajfault=1,184,923``
# （118 万次缺页换入）、PSI ``full avg10=0.08``（**已经存在换页压力**，
# 但还没到 OOM）。
#
# 整机内存构成（``ps`` 按 RSS 汇总，跨多个站点）：
# python 355 MB（**含别的站点**）/ postgres 167 MB / nginx 134 MB /
# gunicorn 119 MB / waitress 69 MB / dockerd 46 MB / BT-Panel 42 MB /
# containerd 26 MB / frps 26 MB。
#
# **API 稳态实测**（``systemctl show cwq-api -p MemoryCurrent``，含页缓存）：
#   * **旧代码 313 MB** —— 2026-10-24 17:14 发布前量到的（跑了 16 小时的稳态）
#   * **新代码 290 MB** —— 本轮优化发版后（17:49 起）连采 5 次，稳定在
#     304,427,008 ~ 304,840,704 字节（≈290 MB）
#   本轮把账簿接口的峰值内存从 98.8 MB 砍到 23.6 MB（−76%）、发票上传从
#   20.0 MB 砍到 0.1 MB —— 稳态降了 23 MB，与「省掉了大部分物化开销」吻合。
#
# **两档是按新代码的 290 MB 算的**：
#   * 软上限 400M = 290 × 1.38 —— 留 38% 余量给正常波动
#     （一次整本账打印、一批发票上传）。
#   * 硬上限 512M —— 约为预估峰值 426 MB（290 + 旧代码的 136 MB 增量）
#     的 1.2 倍。
#
# **为什么硬上限不是 640M**（第二版写过的那个数）：640M 是按
# 「峰值 × 1.5」算的，**只看 API 自己**。但这台机器的内存不是 API 的 ——
# 2026-10-24 实测 ``free -m``：
#
#     total 1676 / used 1276 / **available 399** / swap 1024（**已用 188**）
#
# 也就是说**整机只剩 399 MB 可用**，而且 swap 已经在换了（PSI
# ``full avg10=0.08``，``pgmajfault`` 118 万次）。给 API 留 640 MB 的硬上限，
# 意思是「允许它在这台机只剩 399 MB 可用的时候再吃掉 240 MB」——
# 那一刻被挤到 swap 的不是 API，而是 **PostgreSQL**（整机 OOM killer 挑
# 占用最多的），或者那 3 个**别的业务的** Docker 容器。
# **软上限 400M 恰好解决了这件事**：它是「先让 API 自己回收页缓存、
# 慢下来」，让出的是它自己的内存，不是把压力推给整机。
# 硬上限则是最后一道闸 —— 它的作用是「确定地杀掉 API」，
# 而不是「让整机进入 swap 混战」。所以它必须**小于整机剩余可用内存**。
#
# 这个数还有一道机器守着的闸：
# ``backend/tests/test_perf_production_guards.py::test_内存上限对1gb级的机器是合理的``
# 钉住 ``MemoryMax ≤ 512M``，理由与上面一致（那一台还跑着 11+ 子域与
# 3 个 Docker 容器）。**这条护栏是真的有用**：640M 那版就是它拦下来的，
# CI 当场报 ``assert 640 <= 512``。不要为了一个数去放宽它 —— 要放宽先拿
# 主机实测说话。
#
# **为什么软上限不是 320M**（第一版写的那个数）：320M 对 290 MB 的稳态
# 只剩 **10% 余量** —— 那意味着**常态就贴着软上限跑**，
# ``memory.high`` 触发的节流会从「异常时的保护」变成「常态」，
# 每次大操作都被拖慢。那就失去了这档的意义。
# 软上限的作用是「**异常时先让它慢下来**」，所以它必须明显高于常态。
#
# **因此发布顺序是硬约束：先发代码，后装这一段。**
# 旧代码稳态 313 MB 已经**超过** 320M 的软上限 —— 先装 unit 再发代码，
# unit 一装上就会把正在跑的旧版本节流掉，表现为「发版后接口变慢」，
# 而根因是「内存上限按新代码的数定的，却先套在了旧代码上」。
#
# 另一台生产机（110.42.44.53，/opt/cwq 布局）是 4 GB 档，两档都可以放宽；
# 但**先用 systemctl show cwq-api -p MemoryCurrent 量出真实占用再改**，
# 别把这里的数直接搬过去。
MemoryHigh=400M
MemoryMax=512M

# 财务系统只读代码目录；运行时目录包含发票和可信插件包、journal 备份。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# ---- 可写白名单：加一个配置项就可能要动这一行（2026-10-19 补 backups） ----
#
# `ProtectSystem=strict` 把整棵 /opt 挂成只读，本行是**例外清单**。
# 规则只有一条，且与写的是相对路径还是绝对路径有关：
#
#   * **相对路径**（如 INVOICE_STORAGE_DIR=data/invoices）落在 WorkingDirectory
#     之下，即 backend/data —— 已被本行覆盖，**加配置时不用动这里**。
#   * **绝对路径且在应用树之外**（如 CWQ_BACKUP_WORK_DIR=/opt/cwq/backups/work）
#     —— **必须在这里显式列出**，漏了就是只读文件系统。
#
# 漏掉之后的形态特别难认，所以这一行值得写清楚：它在**写文件那一刻**才失败，
# 而那一刻鉴权、解析、落库都已经过了。更糟的是它发生在凌晨定时任务里 ——
# OSS 备份是应用内调度器（task_key=system:oss_backup）在**这个进程里**跑的，
# 不是另一个 systemd 单元，于是 journal 里只有一条 OSError，没人看；
# 从外面看是「页面一切正常，只是备份静悄悄地不产出了」。
# 判据只能是在服务自己的 mount 命名空间里试写（服务外写总是成功）：
#   PID=$(systemctl show -p MainPID --value cwq-api)
#   nsenter -t "$PID" -m -- mount | grep -E 'ro|rw'
#
# **同一个键只能写一次**（重复赋值是后者覆盖前者），所以所有路径写在同一行。
ReadWritePaths=/opt/cwq/backend/logs /opt/cwq/backend/data /opt/cwq/backups
StandardOutput=append:/opt/cwq/backend/logs/api.log
StandardError=append:/opt/cwq/backend/logs/api.err.log

[Install]
WantedBy=multi-user.target
