{
  "format_version": 1,
  "id": "com.cwq.periodic",
  "name": "周期记账",
  "version": "1.0.0",
  "api_version": ">=1.1.0 <2.0.0",
  "description": "为每个账套维护每月固定支出的规则（记账日、分录、金额），按月生成凭证；页面可手动执行，结账时自动补记漏掉的月份。",
  "permissions": [
    "book:read",
    "book:write",
    "subject:read",
    "voucher:write",
    "plugin_data:rw",
    "audit:write"
  ],
  "access": {
    "assignment": "admin_users",
    "default": "none"
  },
  "contributes": {
    "backend_entry": "backend/main.py",
    "frontend_entry": "frontend/index.js",
    "menu": {
      "module": "extensions",
      "title": "周期记账",
      "icon": "Calendar",
      "route": "/plugin/com.cwq.periodic",
      "order": 40
    }
  },
  "hooks": [
    "on_period_close"
  ],
  "tasks": [
    {
      "name": "monthly_posting",
      "schedule": {
        "type": "cron",
        "expression": "17 7 * * *",
        "timezone": "Asia/Shanghai"
      }
    }
  ],
  "tables": [
    {
      "name": "plugin_769c8e79a72c_rule",
      "schema": "public",
      "scope": "book"
    },
    {
      "name": "plugin_769c8e79a72c_run",
      "schema": "public",
      "scope": "book"
    }
  ]
}
