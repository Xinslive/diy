# 复制成 backend/.env 后按需修改

# 运行环境。dev/test 跳过生产配置校验；**默认 prod（fail-closed）**。
# 本机开发请显式设成 dev，否则会因为下面的默认密钥被拒绝启动（这是故意的）。
APP_ENV=dev

# 端口必须是 **15432**：README 的 `docker run -p 15432:5432` 把容器的 5432
# 映射到宿主 15432，而 config.py 里 DATABASE_URL 的默认值也是 localhost:15432。
# 这里原来写 5432，逐字复制就连不上库（宿主的 5432 上没有东西在听）。
DATABASE_URL=postgresql+psycopg://cwq:cwq123@127.0.0.1:15432/cwq
# SQL 回显开关。**生产环境拒绝 true**（config.py 会在启动前拦下来）。
#
# 它与下面的 LOG_LEVEL 是**两套机制**：echo 交给 SQLAlchemy engine，
# 与 Python 的日志级别无关。也就是说 LOG_LEVEL=INFO + DB_ECHO=true 能从
# LOG_LEVEL 那条校验下面完整走过去，然后安静地把带绑定参数的 SQL
# （= 全公司每一张凭证的金额）写进日志文件，且没有任何警告。
# 所以两者要**分别**看，不是看一个就等于另一个安全。
DB_ECHO=false

# SQLAlchemy 连接池容量
#
# 这四个以前全是 QueuePool 的默认值（仓库里一处都没写）。现在写下来了。
# **前三个的默认值逐字等于原来的行为**（5 / 10 / 30），不改任何现状行为；
# 只有 POOL_RECYCLE 给了新值 300。
#
# ⚠️ 这四项是**每个进程各一套**。systemd 与 Docker 都是 2 个 worker 进程，
#    所以 PG 侧实际连接数 = 进程数 × (POOL_SIZE + POOL_MAX_OVERFLOW)。
#    PostgreSQL 的 max_connections 默认 100 —— 越过去不是「变慢」，而是
#    新连接直接被拒（sorry, too many clients already），应用侧看到的是
#    「拿不到连接」，排查方向会整个跑偏。**调之前先算这个乘法。**
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
# 从池里等连接的最长秒数。调小会让并发一上来就抛连接池超时，而那个报错
# 和「数据库慢」在日志里长得几乎一样。
DB_POOL_TIMEOUT=30
# 连接回收秒数。300s 必须短于云 PG / NAT 常见的 idle 断开阈值（300~600s），
# 否则就成了「等断开之后再去检查」。设为 -1 可退回「永不回收」。
DB_POOL_RECYCLE=300

# supervisor 统一启动器读取 worker 数，默认 2。修改后重启整个服务。
# scripts/start_server.py 在父进程生成 generation/start timestamp 后再启动 worker。
CWQ_API_WORKERS=2

# 调度看门狗的容忍期（分钟）：计划任务逾期多久算「没跑」。
#
# **这个变量是给 systemd unit 读的**，Python 那边读不到它 —— config.py 里
# 没有、也不应该有对应字段（留一个读不到的配置项比没有更危险）。
#
# 30 分钟的由来：tick 是**每分钟**调一次的，正常情况下任务最多晚几分钟；
# 一次发布/维护的窗口也可能长到这个量级。取 30 分钟意味着「短暂的维护不会
# 被误报」，而「外部调度服务真的挂了」会在半小时内被发现 —— 对每天一次的
# 备份来说，仍是当天上午就知道，而不是几天后。
CWQ_WATCHDOG_GRACE_MINUTES=30

# 可信进程内插件默认关闭；生产开启前阅读 docs/plugin-spec.md 的风险与验收记录。
PLUGIN_ENABLED=false
# 必须位于持久数据盘；升级主程序不能覆盖、清空此目录。
PLUGIN_ROOT=data/plugins
# JSON 对象：key_id -> Base64 编码的原始 32 字节 Ed25519 公钥；不要填私钥。
PLUGIN_TRUSTED_KEYS={}
# 逗号分隔的 key_id。revoked/historical 禁止新装，已安装包可用历史公钥复核。
PLUGIN_REVOKED_KEYS=
PLUGIN_HISTORICAL_KEYS=
PLUGIN_MAX_BYTES=20971520
PLUGIN_MAX_UNZIPPED_BYTES=104857600
PLUGIN_MAX_FILE_BYTES=10485760
PLUGIN_MAX_FILES=512
PLUGIN_DISK_QUOTA_BYTES=1073741824
PLUGIN_LEASE_SECONDS=30
PLUGIN_HEARTBEAT_SECONDS=5

# SDK 1.2 导入与定时任务：每批文件数；每用户每账套待处理批次；每账套原文件留存容量。
# 文件/预览大小及条数复用下面的 IMPORT_MAX_*，草稿天数复用 IMPORT_BATCH_TTL_DAYS。
PLUGIN_IMPORT_MAX_FILES=20
PLUGIN_IMPORT_MAX_PENDING=50
PLUGIN_IMPORT_STORAGE_MAX_BYTES=1073741824
# 成功批次的源文件、完整预览及配置留存天数；摘要、结果和来源继续保留。
# 应用级调度器会每小时运行一次到期内容清理。
PLUGIN_IMPORT_RETENTION_DAYS=30

# 外部调度触发密钥不放在 .env：由管理员 API 轮换生成，数据库只保存摘要；
# 外部调度服务每分钟调用 /api/scheduler/tick?key=...，请使用其安全密钥存储。

# 生产必须改成随机长字符串：openssl rand -hex 32（至少 32 字节）
JWT_SECRET=dev-secret-change-me-before-deploy
# 只能是 HS256 / HS384 / HS512 之一。写 none 或任何非 HMAC 算法，
# 生产启动校验会直接拒绝（审计 P2-11：密钥查够了，算法不能是唯一的例外）。
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=720
# 管理员令牌上限（与上面的值取较小者）
ADMIN_TOKEN_MINUTES=240

# 登录失败锁定（按账号）
#
# 口径：**连续失败 LOGIN_MAX_FAILURES 次就锁定**，首次锁定
# LOGIN_LOCK_MINUTES 分钟，之后每多撞一轮锁定翻一档
# （10 → 20 → 30 …，到 LOGIN_LOCK_MAX_MINUTES 为止）。
#
# 递进要解决两个具体的攻击形态：
#   * **慢速爆破** —— 每隔 9 分钟试一次、每次只错一次。恒定时长下它永远
#     不触发阈值，整个锁定机制对它等于不存在。
#   * **故意撞锁** —— 把每次尝试安排在锁定窗口之外，账号被无限期挡在门外。
#
# **代价要知道**：阈值收得紧意味着正常用户输错三次就被挡 10 分钟。
# 管理员可以在「用户与授权」页一键提前解除锁定，不必等满。
LOGIN_MAX_FAILURES=3
LOGIN_LOCK_MINUTES=10
# 锁定时长上限（分钟）。1440 = 一天。
#
# **必须有上限**：没有上限的递进就是「永久锁定」，等于给攻击者一个禁用
# 任意账号的开关。上限让它停在「很久但有限」，管理员始终有介入的窗口。
LOGIN_LOCK_MAX_MINUTES=1440

# 登录来源节流（按 IP，审计 P2-11 的另一半）
#
# 上面那两条是**按账号**锁：一个源只要轮着换用户名，就能对上万个账号各试 3 次，
# 每次只锁一个，锁定机制几乎不生效。下面这组补的是「按来源聚合」这一层。
#
# **默认不做 IP 硬锁**（LOGIN_IP_HARD_LOCK=false）。NAT 后面几百上千人共用一个
# 出口 IP，硬锁会把防护变成故障；更要命的是**攻击者可以主动触发它** —— 从公司网
# 打满阈值，就让全公司长时间登不进来。那不是防住爆破，是把爆破换成 DoS 放大器。
# 默认只做软节流：429 + Retry-After + 留痕，不锁账号也不锁 IP，窗口滑完自动恢复。
LOGIN_IP_THROTTLE_ENABLED=true
# 同一来源在窗口内累计失败多少次后开始拦（取值偏保守：宁可漏放也不误伤共享出口）
LOGIN_IP_MAX_FAILURES=30
# 滑动窗口长度（秒）
LOGIN_IP_WINDOW_SECONDS=900
# 递增延迟：每档加这么多毫秒
LOGIN_IP_DELAY_STEP_MS=200
# 递增延迟封顶（再大的惩罚交给 Retry-After，别占着 worker 不放）
LOGIN_IP_DELAY_MAX_MS=1000
# Retry-After 封顶（秒）
LOGIN_IP_RETRY_AFTER_MAX_SECONDS=900
# 下面两个默认关，打开前请先读完 ARCHITECTURE 里「为什么不做 IP 硬锁」
LOGIN_IP_HARD_LOCK=false
LOGIN_IP_HARD_LOCK_MINUTES=15
# 来源计数保留多久后清理（小时）。状态必须会过期，不能只增不减。
LOGIN_IP_STATE_TTL_HOURS=24

# 可信反向代理白名单（逗号分隔的 IP 或网段，留空 = 不信任任何代理头）
#
# 留空时**只认 TCP 对端**，于是 nginx 后面全站共用 127.0.0.1 一个桶，节流等于没有。
# 用 nginx 部署就把这里设成 127.0.0.1；留空启动时会告警（不拒启动）。
# 设了之后：对端在白名单内才读 X-Real-IP，其次取 X-Forwarded-For 的**最右**一个
# （最左是客户端可以随便写的）。nginx 侧无需改动，cwq.conf 已透传这两个头。
TRUSTED_PROXIES=

# Excel 导入容量上限（审计 P2-02）。
# 应用层不设上限时，一次上传就能把进程的内存吃光、并让暂存表一直涨。
IMPORT_MAX_BYTES=20971520
# ⚠️ 改这一项要同时改 deploy/nginx/cwq.conf 的 client_max_body_size（现在 21m）。
#    nginx 的上限比它高的话，超出应用层的那个区间会被 nginx **完整接收并写进
#    临时文件**，然后才被应用拒掉 —— 白占磁盘、白花 IO，拒绝还晚了一步。
# xlsx 是 zip：下面两个防解压炸弹与解析放大
IMPORT_MAX_UNZIPPED_BYTES=209715200
IMPORT_MAX_ROWS=20000
IMPORT_MAX_VOUCHERS=5000

# 发票原件存储与 PaddleOCR API（不配置 token 时仅支持文本型 PDF）
INVOICE_STORAGE_DIR=data/invoices
# ⚠️ 与 IMPORT_MAX_BYTES 同一条规矩（审计 P2-12）：这里原本写的是 100MB，
#    而网关的 client_max_body_size 是 21m —— 小的那条先生效，21~100MB 的发票
#    批次会先被 nginx 完整接收、写进临时文件，才被应用层拒掉。也就是说那个
#    100MB **从来没真正生效过**，只是让配置看着比实际宽松。
#    现已与 import 对齐到 20MB：这是零能力损失（100MB 本来就被网关挡在门外）。
INVOICE_MAX_BYTES=20971520
# 批量上传（多文件 / 整个文件夹）时**合计**的体积上限与文件数上限。
# 网关 client_max_body_size=21m 限的是整个请求体，所以合计上限与 INVOICE_MAX_BYTES
# 同档；再调大要两边一起改。
INVOICE_MAX_TOTAL_BYTES=20971520
INVOICE_MAX_FILES=60
INVOICE_OCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
INVOICE_OCR_API_TOKEN=
INVOICE_OCR_MODEL=PaddleOCR-VL-1.6
INVOICE_OCR_TIMEOUT_SECONDS=600
INVOICE_OCR_POLL_SECONDS=5
INVOICE_OCR_OPTIONAL_PAYLOAD={"useDocOrientationClassify":false,"useDocUnwarping":false,"useChartRecognition":false}
# 未确认的暂存批次保留天数（确认/作废时载荷当场清空，这一项管「忘了确认」的）
IMPORT_BATCH_TTL_DAYS=7

# ---------------------------------------------------------------------------
# 邮件通知 / SMTP（系统管理 → 邮件通知）
# ---------------------------------------------------------------------------
# **这一段只是 env 兜底**，正常配的是界面「系统管理 → 邮件通知」里的表单，
# 存在 sys_setting 表里；页面上配的优先于这里（app/notify/config.py 的
# smtp_config：库里有的用库里，没有的才退回 env）。
#
# 通知的用途是**主动发现**那些只落在审计表里、没人会去看的事：账号被锁定、
# 定时任务失败、备份失败。审计表是证据通道（要人主动去翻），邮件是检测
# 通道（当时就到）。
#
# **口令只写不读**：界面上改完就再也读不回来，只能覆盖重填。响应里只有
# 「配没配」与末 4 位。
#
# 加密方式：**SMTP_USE_SSL 与 SMTP_USE_TLS 只能开一个**。465 用隐式 TLS
# （SSL=true、TLS=false），587 用 STARTTLS（SSL=false、TLS=true），
# 两个都开会让服务器在最远的一次连接上直接报错，而那个现场极难复现。
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
SMTP_USE_TLS=true
# 单次发送超时（秒）。发不出去必须**很快**地失败 —— 通知是旁路，
# 不能让它把登录接口或定时任务拖住。
SMTP_TIMEOUT_SECONDS=10
# 收件邮箱，逗号分隔。留空则不发任何通知。
NOTIFY_RECIPIENTS=
# 通知总开关。关掉之后配置仍然保留，随时可以再打开。
NOTIFY_ENABLED=true
# 同一类告警在一个窗口内最多单独发几封。
#
# **为什么需要这个旋钮**：邮件通道和「操作日志」的区别在于后者只有管理员
# 能写，前者**任何人都能触发**。攻击者对一批账号各试三次错误口令，就能
# 让系统发出成百上千封「账号锁定」告警 —— 管理员的邮箱被灌满（真告警淹没
# 在里面），邮件服务商那边这个发件域名也会被判成垃圾邮件源，于是连**真正
# 的**告警都发不出去。两个效果都是攻击者花几分钱就能买到的。
#
# 超出的告警不发信，但**计数留着**：下一封真能发出去时，正文里会补一句
# 「另有 N 条同类告警未单独通知」。全量明细始终在「操作日志」里。
#
# 按**事件类型**分桶：锁定告警刷屏不会把「备份失败」一起压掉。
NOTIFY_RATE_LIMIT=20
# 限流窗口（秒）。默认 10 分钟。
NOTIFY_RATE_WINDOW_SECONDS=600

# ---------------------------------------------------------------------------
# 管理员二次验证（邮箱链接）
# ---------------------------------------------------------------------------
# **形态**：复用上面那套 SMTP 通道。管理员口令验过之后，系统往**通知邮箱**
# （NOTIFY_RECIPIENTS）发一封带一次性链接的邮件，点链接即完成登录。
# 二次验证邮件**不走** NOTIFY_ENABLED 那个总开关 —— 那是「告警要不要发」，
# 而二次验证邮件是**认证的一部分**；总开关一关管理员就再也登不进系统。
#
# **默认关闭，这是刻意的。** 强制开二次验证的第一前提是「通知邮箱通道已经配好
# 且发得出信」。默认开着而 SMTP 没配，等于把所有管理员一次性锁在门外 ——
# 那是把一个安全能力变成一次可用性事故。**先配好收件人，再开这个开关**
# （开关也可以在界面「系统管理」里改，改完即生效，不必重启）。
ADMIN_MFA_ENABLED=false
# 高危动作（改他人口令 / 装插件 / 读 OSS 凭据 / 轮换调度密钥 / 删用户）的
# 「近期重新认证」窗口（分钟）。管理员验过二次因子之后，这个窗口内做这些
# 动作不再重复要求走邮箱；超过窗口则要求重新验一次。
# 5 分钟的取法：一次「连着改两个配置」不该被邮件打断两次，
# 而 5 分钟也短到「离开工位倒了杯水回来」就必然过期。
ADMIN_MFA_GRACE_MINUTES=5
# 二次验证链接的有效期（秒）。
# **短，是这里最重要的一条**：邮件链接的强度完全取决于「从发出到点开」这段
# 时间里链接会不会被别人先看到 —— 收件箱在公司的邮件网关里、可能被备份、
# 被 IT 留档、被手机锁屏预览。链接活得越久，被旁路点开的概率越高。
# 10 分钟足够管理员从收件箱点开一次，又短到「过了一夜的邮件」彻底作废。
ADMIN_MFA_TTL_SECONDS=600
# 「重新发送验证邮件」的最短间隔（秒）。
# 没有它，一次误点「登录」就能把收件箱刷满几十封信 —— 而收件箱是**通知
# 通道本身**，把它刷爆等于把告警通道一起刷爆了。
ADMIN_MFA_RESEND_INTERVAL_SECONDS=60
# 二次验证链接的站点前缀（例如 https://acct.example.com）。
# **为什么要有它，而不是用请求里的 Host 头**：Host 头是**客户端给的**。
# 拿它拼邮件里的链接，等于让攻击者能把自己控制的域名写进那封信 ——
# 收件人点开就是跳到攻击者的站点（钓鱼链接的经典做法），而信还是**系统
# 自己发的**、域名还显示得很正规。留空时退回请求的 base_url 并记警告。
ADMIN_MFA_LINK_BASE=
# 应急旁路：允许「一次性口令」直接完成二次验证（不经邮箱）。
# **为什么需要它**：邮箱通道会坏（SMTP 挂了、域名被 SPF 拒了、邮件进了垃圾
# 箱），而它一旦坏掉，管理员就再也登不进系统了 —— 那是一个只能靠 ssh 上
# 服务器跑脚本才能解除的死锁。这个口令由运维在服务器上生成，用一次即废。
# 它从不写进数据库、从不写进接口响应、只活在进程环境里。
# 留空 = 没有应急口令（默认）。生成方式：python backend/scripts/mfa_admin.py --emergency-code
ADMIN_MFA_EMERGENCY_CODE=

# ---------------------------------------------------------------------------
# 账套数据备份到阿里云 OSS（系统管理 → 数据安全）
# ---------------------------------------------------------------------------
# **这一段只是 env 兜底**，正常配的是界面「系统管理 → 数据安全」里的表单，
# 存在 sys_setting 表里；页面上配的优先于这里（app/backup/config.py 的
# oss_config：库里有的用库里，没有的才退回 env）。
# 为什么留 env：容器/应急场景要在 API 起来之前先有配置，以及 OSS 未配好时
# 手动用 scripts/backup_to_oss.py 排障。
#
# ⚠️ 两个 AccessKey 是**只写不读**的：GET /system/backup 永远不返回明文，
#    页面拿到的是 mask 过的提示（已配置 …EYID）。改密钥只能整份重填，
#    没有「回显」这条路。往 .env 里明文写是可以的（文件权限 600），
#    但别把它提交进 git。
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# 对象键的顶层前缀。留空 = 直接铺在 Bucket 根目录，而那个 Bucket 可能还放着
# 别的东西。放进一个命名空间，将来清理、迁移、配生命周期规则都只在自己的一亩地里。
OSS_PREFIX=acct-backup

# 总开关。关掉之后页面和脚本都不会上传（脚本要显式加 --ignore-enabled 才能跑）。
BACKUP_ENABLED=true
# 是否额外导出一份**系统级**快照（用户、审计日志、系统参数等不属于任何账套的表）。
# 关掉就只有每账套一份，运维配置本身不在备份里 —— 那意味着「误改配置」只能靠记忆恢复。
BACKUP_INCLUDE_SYSTEM=true
# 天备份 / 周备份的保留天数。**月度备份没有这一项，永远保留**：
# 它在代码里是结构性的（app/backup/retention.py 对 monthly 直接跳过，
# plan_deletions 入口再挡一次），不是靠「保留天数设成一个很大的数」实现的。
# 成配置项反而危险 —— 哪天有人把它改成 3650，「永久」就悄悄变成了 10 年。
BACKUP_KEEP_DAILY_DAYS=30
BACKUP_KEEP_WEEKLY_DAYS=365
# 导出时的本地临时目录（上传完即删）。用 /tmp 之外的地方：备份产物是全量账务数据，
# 落到一个别的账号能列出来的目录里，是在给备份本身制造风险。
#
# ⚠️ **改这一项必须同步改 cwq-api.service 的 ReadWritePaths。**
# OSS 备份是应用内调度器在这个进程里跑的，而 cwq-api.service 开了
# ProtectSystem=strict —— 整个文件系统只读，白名单外一律写不进去。
# 所以这是个**绝对路径**：不像 INVOICE_STORAGE_DIR=data/invoices 那样落在
# backend/data 里自动被覆盖，这里指向应用树之外，必须在 unit 的 ReadWritePaths
# 里显式列出。漏了不会立刻报错：备份跑到写文件那一步才失败，凌晨定时任务里
# 没人看 journal，表现是「页面正常、备份一天都没成功过」。
# 2026-10-19 生产上就是这么丢了一批备份的（work 目录当时不在白名单里）。
CWQ_BACKUP_WORK_DIR=/opt/cwq/backups/work

# 这里原来还有一条 DEFAULT_TIMEZONE，config.py 里那个字段已经删掉了（审计 P2-23）：
# 它定义了但全仓零引用，留着会让运维以为设了就能改时区。部署时区由进程/数据库会话
# 的 TZ 决定（docker-compose.yml 与 deploy/systemd 里的 TZ=Asia/Shanghai）。

# 自助注册：**默认关闭**。公司内部要开就置 true；对外暴露时保持关闭，
# 由管理员开号（审计 P3-04 第 2 条）。config.py 里也是 False，三处必须一致。
REGISTRATION_ENABLED=false

# 日志级别（审计 P3-14）。合法值：CRITICAL/ERROR/WARNING/INFO/DEBUG/NOTSET。
# 默认 INFO；**生产环境拒绝 DEBUG**（会把 SQL 与账套数据打进日志）。
# 非法值不静默回退，直接拒绝启动并在报错里列出合法取值。
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# nginx 限流开关（本文件只是**说明**，nginx 不读 .env）
# ---------------------------------------------------------------------------
# nginx 侧的限流是**默认关闭**的，而且 cwq.conf 里**刻意不提供任何默认阈值**：
# 阈值只能用业务峰值定，而这套系统目前没有峰值测量数据。月结日和平日的并发
# 能差一个数量级，凭空写一个数上去，要么形同虚设，要么在月结那天把全公司
# 挡在门外 —— 那是比不限流更糟的结果。
#
# 要打开，在**两个**文件里分别写（上下文不同，不能混）：
#   /etc/nginx/cwq-include/cwq-rl-zone.conf   （http 级）
#       limit_req_zone  $binary_remote_addr zone=cwq_api:10m rate=<阈值>;
#       limit_conn_zone $binary_remote_addr zone=cwq_api_conn:10m;
#   /etc/nginx/cwq-include/cwq-rl-api.conf    （location 级）
#       limit_req  zone=cwq_api burst=<突发量> nodelay;
#       limit_conn cwq_api_conn <并发连接数>;
# 然后 nginx -t && systemctl reload nginx；删掉这两个文件即关闭。
# 详细说明与踩过的坑见 deploy/nginx/cwq.conf 的「限流开关」段。
